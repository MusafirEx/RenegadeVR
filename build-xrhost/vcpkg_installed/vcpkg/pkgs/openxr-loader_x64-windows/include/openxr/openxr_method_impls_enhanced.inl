        result = static_cast<Result>( d.xrEnumerateFacialSimulationModesBD(this->get(), modeCapacityInput, &modeCountOutput, reinterpret_cast<XrFacialSimulationModeBD*>(modes.data())) );
    } while (result == xr::Result::ErrorSizeInsufficient);
    if (succeeded(result)) {
        OPENXR_HPP_ASSERT(modeCountOutput <= modes.size());
        modes.resize(modeCountOutput);
    } else modes.clear();
    
            OPENXR_HPP_ASSERT( succeeded(result) );


    return { result, std::move(modes) };

}

