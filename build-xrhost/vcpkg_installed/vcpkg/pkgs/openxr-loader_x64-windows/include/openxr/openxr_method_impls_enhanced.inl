template <typename Allocator, typename Dispatch, OPENXR_HPP_REQUIRE_DISPATCH(Dispatch)>
OPENXR_HPP_INLINE ResultValue<std::vector<AudioSampleRateBD, Allocator>> Session::enumerateSupportedAudioSampleRateToVectorBD (
    Dispatch&& d) const {
    std::vector<AudioSampleRateBD, Allocator> sampleRates;
        uint32_t sampleRateCountOutput = 0;
    uint32_t sampleRateCapacityInput = 0;

    
    Result result = static_cast<Result>( d.xrEnumerateSupportedAudioSampleRateBD(this->get(), sampleRateCapacityInput, &sampleRateCountOutput, nullptr) );
    if (!unqualifiedSuccess(result) || sampleRateCountOutput == 0) {
                OPENXR_HPP_ASSERT( succeeded(result) );


        return { result, std::move(sampleRates) };
    }
    do {
        sampleRates.resize(sampleRateCountOutput);
        sampleRateCapacityInput = static_cast<uint32_t>(sampleRates.size());
        result = static_cast<Result>( d.xrEnumerateSupportedAudioSampleRateBD(this->get(), sampleRateCapacityInput, &sampleRateCountOutput, reinterpret_cast<XrAudioSampleRateBD*>(sampleRates.data())) );
    } while (result == xr::Result::ErrorSizeInsufficient);
    if (succeeded(result)) {
        OPENXR_HPP_ASSERT(sampleRateCountOutput <= sampleRates.size());
        sampleRates.resize(sampleRateCountOutput);
    } else sampleRates.clear();
    
            OPENXR_HPP_ASSERT( succeeded(result) );


    return { result, std::move(sampleRates) };

}

